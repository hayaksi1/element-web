From f58256f513c81ac11652366b70e1e81b046256f5 Mon Sep 17 00:00:00 2001
From: hayaksi1 <193020925+hayaksi1@users.noreply.github.com>
Date: Fri, 4 Sep 2026 17:43:33 +0300
Subject: [PATCH] Open threads full-size by default on the integration build

The full-size thread view ships off, because the branch carrying it is
an upstream pull request and upstream's default has to stay upstream's
call. The fork made the opposite call long before the split: a thread
opens where the room was, not in a strip beside it, and the right panel
is left for the panels it was designed for.

That difference exists only where the setting and the fork's preference
meet, which is here and nowhere else -- neither the pull request nor any
feature branch can carry it without deciding it for the other. Hence the
integration patch, and hence the assertion beside it: a patch that stops
applying is otherwise indistinguishable from a patch that was never
needed, and the rebuild would ship the upstream default in silence.

The Preferences snapshot moves with it. That tab is the only place the
toggle is rendered, so the flipped default surfaces there as one checked
attribute; regenerating it here rather than in the snapshot patch keeps
that patch describing nothing but the CSS-module hash.
---
diff --git a/apps/web/src/settings/ForkSettingDefaults.test.ts b/apps/web/src/settings/ForkSettingDefaults.test.ts
new file mode 100644
index 0000000000..dcfec07193
--- /dev/null
+++ b/apps/web/src/settings/ForkSettingDefaults.test.ts
@@ -0,0 +1,18 @@
+/*
+Copyright 2026 hayaksi1
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE files in the repository root for full details.
+*/
+
+// @vitest-environment happy-dom
+
+import { describe, expect, it } from "vitest";
+
+import { SETTINGS } from "./Settings.tsx";
+
+describe("fork setting defaults", () => {
+    it("opens threads full-size in the main split out of the box", () => {
+        expect(SETTINGS["Threads.fullSizeView"].default).toBe(true);
+    });
+});
diff --git a/apps/web/src/settings/Settings.tsx b/apps/web/src/settings/Settings.tsx
index fc4b766e3f..90a6f92f3e 100644
--- a/apps/web/src/settings/Settings.tsx
+++ b/apps/web/src/settings/Settings.tsx
@@ -1332,7 +1332,7 @@ export const SETTINGS: Settings = {
         supportedLevels: LEVELS_ACCOUNT_SETTINGS,
         displayName: _td("settings|preferences|threads_full_size_view"),
         description: _td("settings|preferences|threads_full_size_view_description"),
-        default: false,
+        default: true,
     },
     "Performance.addSendMessageTimingMetadata": {
         supportedLevels: [SettingLevel.CONFIG],
diff --git a/apps/web/src/components/views/settings/tabs/user/__snapshots__/PreferencesUserSettingsTab.test.tsx.snap b/apps/web/src/components/views/settings/tabs/user/__snapshots__/PreferencesUserSettingsTab.test.tsx.snap
index 0cb2d6d786..5961839c85 100644
--- a/apps/web/src/components/views/settings/tabs/user/__snapshots__/PreferencesUserSettingsTab.test.tsx.snap
+++ b/apps/web/src/components/views/settings/tabs/user/__snapshots__/PreferencesUserSettingsTab.test.tsx.snap
@@ -1171,6 +1171,7 @@ exports[`PreferencesUserSettingsTab > should render 1`] = `
                       class="_container_udcm8_10"
                     >
                       <input
+                        checked=""
                         class="_input_udcm8_24"
                         disabled=""
                         id="mx_SettingsFlag_7Az0xw4Bs4Tt"
