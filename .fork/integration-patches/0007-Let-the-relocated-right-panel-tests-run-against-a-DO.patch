 .../views/right_panel/RoomSearchJumpToDate.test.tsx           | 4 +++-
 .../views/right_panel/RoomSearchOrderToggle.test.tsx          | 2 ++
 .../views/right_panel/RoomSearchSenderFilter.test.tsx         | 2 ++
 4 files changed, 10 insertions(+), 2 deletions(-)

