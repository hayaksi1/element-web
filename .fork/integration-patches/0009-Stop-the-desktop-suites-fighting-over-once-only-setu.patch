Date: Thu, 27 Aug 2026 20:27:35 +0300
Subject: [PATCH 09/10] Stop the desktop suites fighting over once-only setup

Both of these break for the same underlying reason: the merge put two
suites that each assumed they owned the module into one file, and neither
tolerates the other having gone first.

The theme-colour suite looked its handler up by replaying the recorded
ipcMain.on calls, but the module registers its handlers once at import
while every earlier suite calls clearAllMocks, so by the time this one
runs the recording is empty and the lookup reads a property of undefined.
The registration map the mock already maintains holds the same handler and
survives clearing, which is how the rest of the file resolves handlers.

The store suite called initialize a second time, which is deliberately
fatal because the store is a singleton. Reusing the existing instance and
falling back to initialising keeps the suite working whether or not the
earlier one has run, so it still stands alone under a test filter.
---
 apps/desktop/src/ipc.test.ts   | 4 ++--
 apps/desktop/src/store.test.ts | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/apps/desktop/src/ipc.test.ts b/apps/desktop/src/ipc.test.ts
index 76a4c5b4a4..5bac4fb4d7 100644
--- a/apps/desktop/src/ipc.test.ts
+++ b/apps/desktop/src/ipc.test.ts
@@ -6,7 +6,7 @@ Please see LICENSE files in the repository root for full details.
 */
 
 import { expect, describe, it, vi, beforeAll, beforeEach, afterEach } from "vitest";
-import { desktopCapturer, ipcMain, type IpcMainInvokeEvent } from "electron";
+import { desktopCapturer, type IpcMainInvokeEvent } from "electron";
 
 import { getConfig } from "./config.js";
 import { consumeDisplayMediaCallback } from "./displayMediaCallback.js";
@@ -197,7 +197,7 @@ describe("setThemeColor", () => {
 
     beforeAll(async () => {
         await import("./ipc.js");
-        handler = vi.mocked(ipcMain.on).mock.calls.find(([channel]) => channel === "setThemeColor")![1] as never;
+        handler = ipcHandlers["setThemeColor"] as never;
         expect(handler).toBeDefined();
     });
 
diff --git a/apps/desktop/src/store.test.ts b/apps/desktop/src/store.test.ts
index ac2712e9ac..699099b867 100644
--- a/apps/desktop/src/store.test.ts
+++ b/apps/desktop/src/store.test.ts
@@ -204,7 +204,7 @@ describe("Store", () => {
     let store: Store;
 
     beforeAll(() => {
-        store = Store.initialize(undefined);
+        store = Store.instance ?? Store.initialize(undefined);
     });
 
     beforeEach(() => {
