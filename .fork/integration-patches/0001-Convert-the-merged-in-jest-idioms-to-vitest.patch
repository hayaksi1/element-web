From a2818750dcfd45f00c2aac599e837c1ef6aad626 Mon Sep 17 00:00:00 2001
From: hayaksi1 <193020925+hayaksi1@users.noreply.github.com>
Date: Thu, 27 Aug 2026 19:41:21 +0300
Subject: [PATCH] Convert the merged-in jest idioms to vitest

Contribution branches were written against the old jest suite at
apps/web/test/**. Upstream has since co-located those files under
apps/web/src/** and runs them with vitest, where `jest` is simply not
defined - so every merged-in jest.fn/jest.spyOn/jest.SpyInstance is a test
that throws on the first line rather than one that fails honestly.

Rewrites them to vi.*, and jest.SpyInstance to vitest's MockInstance. No
assertion changes; this only restores the calls the runner can execute.

Fork-Feature: fork-tooling
---
 apps/web/src/audio/PlaybackQueue.test.ts                    | 2 +-
 apps/web/src/components/structures/LoggedInView.test.tsx    | 4 ++--
 .../components/views/rooms/BasicMessageComposer.test.tsx    | 4 ++--
 apps/web/src/components/views/spaces/SpacePanel.test.tsx    | 6 +++---
 4 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/apps/web/src/audio/PlaybackQueue.test.ts b/apps/web/src/audio/PlaybackQueue.test.ts
index 8637fc5187..25d31a3a66 100644
--- a/apps/web/src/audio/PlaybackQueue.test.ts
+++ b/apps/web/src/audio/PlaybackQueue.test.ts
@@ -36,7 +36,7 @@ describe("PlaybackQueue", () => {
      */
     const enqueue = (eventId: string): { mxEvent: Mocked<MatrixEvent>; playback: MockedPlayback } => {
         const mxEvent = {
-            getId: jest.fn().mockReturnValue(eventId),
+            getId: vi.fn().mockReturnValue(eventId),
         } as unknown as Mocked<MatrixEvent>;
         const playback = new MockedPlayback(PlaybackState.Stopped, 0, 0);
         playbackQueue.unsortedEnqueue(mxEvent, playback as unknown as Mocked<Playback>);
