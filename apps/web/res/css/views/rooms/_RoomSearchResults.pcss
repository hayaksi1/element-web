/*
 * The search-results area while the Telegram-style dropdown (search Phase 6) is shown. RoomSearchView is kept
 * mounted underneath as the data engine; the dropdown overlays it.
 */
.mx_RoomView_searchResultsWrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1 1 0;
    min-height: 0;
}

.mx_RoomSearchResults {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    background-color: var(--cpd-color-bg-canvas-default);

    .mx_RoomSearchResults_status {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--cpd-space-8x);
        color: var(--cpd-color-text-secondary);
        font: var(--cpd-font-body-md-regular);
        text-align: center;
    }

    .mx_RoomSearchResults_list {
        display: flex;
        flex-direction: column;
    }

    .mx_RoomSearchResults_row {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-3x);
        padding: var(--cpd-space-2x) var(--cpd-space-4x);
        cursor: pointer;
        border: none;
        background: transparent;
        text-align: start;
        width: 100%;
        box-sizing: border-box;

        &:hover,
        &:focus-visible {
            background-color: var(--cpd-color-bg-action-secondary-hovered);
        }

        .mx_RoomSearchResults_row_text {
            display: flex;
            flex-direction: column;
            flex: 1;
            min-width: 0;
            gap: var(--cpd-space-0-5x);
        }

        .mx_RoomSearchResults_row_sender {
            font: var(--cpd-font-body-md-semibold);
            color: var(--cpd-color-text-primary);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .mx_RoomSearchResults_row_body {
            font: var(--cpd-font-body-sm-regular);
            color: var(--cpd-color-text-secondary);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .mx_RoomSearchResults_row_date {
            flex-shrink: 0;
            align-self: flex-start;
            font: var(--cpd-font-body-sm-regular);
            color: var(--cpd-color-text-secondary);
        }
    }
}
