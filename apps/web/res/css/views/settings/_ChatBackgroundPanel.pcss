.mx_ChatBackgroundPanel_presets {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cpd-space-3x);
}

.mx_ChatBackgroundPanel_swatch {
    display: flex;

    .mx_ChatBackgroundPanel_swatch_preview {
        width: 96px;
        height: 64px;
        border-radius: 8px;
        background-color: var(--cpd-color-bg-canvas-default);
        background-position: center;
        border: 1px solid var(--cpd-color-border-interactive-secondary);
    }

    .mx_ChatBackgroundPanel_swatch_row {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-2x);
        margin-top: var(--cpd-space-1x);
    }
}

.mx_ChatBackgroundPanel_actions {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    margin-top: var(--cpd-space-4x);
}

.mx_ChatBackgroundPanel_error {
    color: var(--cpd-color-text-critical-primary);
}

.mx_ChatBackgroundPanel_opacity {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
    margin-top: var(--cpd-space-4x);

    input[type="range"] {
        flex: 1;
        max-width: 240px;
    }
}
